//! Signature verification wrappers with a uniform byte-array interface.
//! One wrapper per (algorithm, curve); the message hash length is generic
//! so SHA-1..SHA-512 digests all fit the same entry points.
//!
//! Only the curves a circuit actually uses are here. Wrappers for P-384 and
//! Brainpool P-384r1 were removed: nothing called them and no vector
//! exercised them, and an untested signature check that looks available is
//! worse than one that is absent. They belong back here alongside the
//! variant that needs them, with a vector.
//!
//! Byte deserialization in noir-bignum enforces only that a value is below
//! 2^MOD_BITS, not that it is reduced, so each wrapper calls
//! `validate_in_field` on the key and signature scalars it decodes rather
//! than leaving that to callers.
//!
//! Low-s requirement. The ECDSA backend rejects any signature whose s
//! exceeds n/2, and aborts rather than returning false. Certificate and
//! CMS signatures follow RFC 5280 and RFC 5480, which place no such
//! restriction, so roughly half of genuine documents carry a signature
//! with s above n/2. Callers must therefore normalize s to n - s before
//! building the witness whenever s exceeds n/2.
//!
//! Normalizing is sound. ECDSA verification accepts (r, s) exactly when it
//! accepts (r, n - s), so both encode the same signing act by the same
//! key over the same digest; substituting one for the other neither
//! creates a signature the issuer did not produce nor lets a prover
//! satisfy the circuit without one. Doing it outside the circuit keeps
//! the gate count unchanged. Witness preparation is where it belongs, and
//! no such code exists yet: until it does, every caller has to normalize
//! for itself.

use bigcurve::curves::secp256r1::{Secp256r1_Fq, Secp256r1_Fr};

use bignum::BigNum;

use ecdsa::ecdsa::verify_secp256r1_ecdsa;

pub fn verify_ecdsa_p256<let H: u32>(
    pubkey_x: [u8; 32],
    pubkey_y: [u8; 32],
    msg_hash: [u8; H],
    sig_r: [u8; 32],
    sig_s: [u8; 32],
) {
    let x: Secp256r1_Fq = Secp256r1_Fq::from_be_bytes(pubkey_x);

    let y: Secp256r1_Fq = Secp256r1_Fq::from_be_bytes(pubkey_y);

    let r: Secp256r1_Fr = Secp256r1_Fr::from_be_bytes(sig_r);

    let s: Secp256r1_Fr = Secp256r1_Fr::from_be_bytes(sig_s);

    x.validate_in_field();

    y.validate_in_field();

    r.validate_in_field();

    s.validate_in_field();

    assert(verify_secp256r1_ecdsa(x, y, msg_hash, (r, s)), "sig: ecdsa p256 verification failed");
}

// Vector generated with openssl (prime256v1, sha256) and verified by
// openssl before embedding; message: "zkICAO p256 test vector message".
// openssl produced s above n/2, so s is stored here as n - s per the
// normalization rule described above.
#[test]
fn p256_sha256_openssl_vector() {
    let hash: [u8; 32] = [
        0x32, 0x30, 0x0b, 0x13, 0x52, 0x02, 0x92, 0x12, 0x60, 0x72, 0x06, 0x77, 0x53, 0x81, 0x75,
        0x54, 0x74, 0x27, 0x91, 0xeb, 0x70, 0x6a, 0x77, 0x5d, 0xb3, 0x60, 0x6d, 0x8e, 0xa9, 0x81,
        0x95, 0xe7,
    ];

    let x: [u8; 32] = [
        0x30, 0xe5, 0xea, 0x5e, 0x62, 0x22, 0x7f, 0xbc, 0x6b, 0x71, 0xe3, 0xad, 0x3b, 0x96, 0x6c,
        0xb6, 0x27, 0x2d, 0x0f, 0x1f, 0x80, 0xcb, 0x9c, 0x39, 0xe1, 0x77, 0xf7, 0x15, 0x86, 0xe6,
        0xbf, 0x88,
    ];

    let y: [u8; 32] = [
        0xeb, 0xd8, 0x6f, 0x0a, 0x27, 0x0a, 0xd9, 0x25, 0x10, 0xb7, 0x37, 0xe4, 0x41, 0x6a, 0x0a,
        0x50, 0xda, 0x80, 0x14, 0x89, 0xdd, 0x25, 0x32, 0x85, 0x3c, 0xb4, 0xa5, 0xb0, 0x13, 0x3f,
        0x6a, 0xfb,
    ];

    let r: [u8; 32] = [
        0x3f, 0x91, 0x7b, 0xaf, 0x46, 0xfd, 0xdc, 0xe8, 0x5d, 0x6c, 0xb2, 0x9c, 0x1e, 0xf8, 0xa4,
        0xce, 0xe5, 0x25, 0x54, 0x75, 0xa5, 0xd5, 0xb5, 0x64, 0xb0, 0x8f, 0x71, 0xa2, 0x50, 0xdc,
        0xd6, 0xb9,
    ];

    let s: [u8; 32] = [
        0x62, 0x28, 0x4c, 0x40, 0x55, 0xd8, 0xcd, 0x38, 0x9d, 0x04, 0xe7, 0xa1, 0x79, 0x95, 0x32,
        0x31, 0x1d, 0xee, 0xa4, 0x00, 0x7b, 0xa6, 0x28, 0x3a, 0xe4, 0xfb, 0xed, 0xe7, 0xb1, 0xdf,
        0x23, 0x76,
    ];

    verify_ecdsa_p256(x, y, hash, r, s);
}

#[test(should_fail_with = "sig: ecdsa p256 verification failed")]
fn p256_rejects_tampered_hash() {
    let hash: [u8; 32] = [
        0x33, 0x30, 0x0b, 0x13, 0x52, 0x02, 0x92, 0x12, 0x60, 0x72, 0x06, 0x77, 0x53, 0x81, 0x75,
        0x54, 0x74, 0x27, 0x91, 0xeb, 0x70, 0x6a, 0x77, 0x5d, 0xb3, 0x60, 0x6d, 0x8e, 0xa9, 0x81,
        0x95, 0xe7,
    ];

    let x: [u8; 32] = [
        0x30, 0xe5, 0xea, 0x5e, 0x62, 0x22, 0x7f, 0xbc, 0x6b, 0x71, 0xe3, 0xad, 0x3b, 0x96, 0x6c,
        0xb6, 0x27, 0x2d, 0x0f, 0x1f, 0x80, 0xcb, 0x9c, 0x39, 0xe1, 0x77, 0xf7, 0x15, 0x86, 0xe6,
        0xbf, 0x88,
    ];

    let y: [u8; 32] = [
        0xeb, 0xd8, 0x6f, 0x0a, 0x27, 0x0a, 0xd9, 0x25, 0x10, 0xb7, 0x37, 0xe4, 0x41, 0x6a, 0x0a,
        0x50, 0xda, 0x80, 0x14, 0x89, 0xdd, 0x25, 0x32, 0x85, 0x3c, 0xb4, 0xa5, 0xb0, 0x13, 0x3f,
        0x6a, 0xfb,
    ];

    let r: [u8; 32] = [
        0x3f, 0x91, 0x7b, 0xaf, 0x46, 0xfd, 0xdc, 0xe8, 0x5d, 0x6c, 0xb2, 0x9c, 0x1e, 0xf8, 0xa4,
        0xce, 0xe5, 0x25, 0x54, 0x75, 0xa5, 0xd5, 0xb5, 0x64, 0xb0, 0x8f, 0x71, 0xa2, 0x50, 0xdc,
        0xd6, 0xb9,
    ];

    let s: [u8; 32] = [
        0x62, 0x28, 0x4c, 0x40, 0x55, 0xd8, 0xcd, 0x38, 0x9d, 0x04, 0xe7, 0xa1, 0x79, 0x95, 0x32,
        0x31, 0x1d, 0xee, 0xa4, 0x00, 0x7b, 0xa6, 0x28, 0x3a, 0xe4, 0xfb, 0xed, 0xe7, 0xb1, 0xdf,
        0x23, 0x76,
    ];

    verify_ecdsa_p256(x, y, hash, r, s);
}
