# Generated by fixtures/generator with the templates subcommand. Do not edit.
#
# Copy this to Prover.toml and replace every placeholder with your own
# material. Nothing here is a working value: a witness holds one holder's
# document, so no real one is committed anywhere in this repository.
#
# Where a value comes from is written beside it. The witness tools under
# tools/ derive the ones that are hashes of something else, so that they are
# computed by the same library the circuit checks them against.

# the signer certificate body, zero padded
tbs = ["<your tbs>", "<your tbs>", "..."]  # 512 elements in total

# the true length of the certificate body
tbs_len = "<your tbs len>"

# byte offset of the subject public key inside tbs
public_key_offset = "<your public key offset>"

# byte offset of the notBefore time inside tbs
not_before_offset = "<your not before offset>"

# byte offset of the notAfter time inside tbs
not_after_offset = "<your not after offset>"

# the country signing key modulus as limbs
authority_modulus = ["<your authority modulus>", "<your authority modulus>", "..."]  # 18 elements in total

# the Barrett parameter for the authority modulus
authority_redc = ["<your authority redc>", "<your authority redc>", "..."]  # 18 elements in total

# the authority signature over tbs, as limbs
authority_signature = ["<your authority signature>", "<your authority signature>", "..."]  # 18 elements in total

# which leaf of the published tree is yours
authority_index = "<your authority index>"

# from tools/merkle_path, or tools/mrz_opening for a field opening
authority_siblings = ["<your authority siblings>", "<your authority siblings>", "..."]  # 10 elements in total

# the same value the sod proof used as dsc_salt
salt = "<your salt>"

# from tools/merkle_path over tools/modulus_leaf entries
master_list_root = "<your master list root>"

# the date this proof is made, as YYYYMMDD
current_yyyymmdd = "<your current yyyymmdd>"

# your application, a non zero value distinct from every other application
domain = "<your domain>"

# a fresh non zero value the verifier issued for this exchange
context = "<your context>"
