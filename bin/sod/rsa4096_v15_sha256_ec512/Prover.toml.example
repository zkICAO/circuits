# Generated by fixtures/generator with the templates subcommand. Do not edit.
#
# Copy this to Prover.toml and replace every placeholder with your own
# material. Nothing here is a working value: a witness holds one holder's
# document, so no real one is committed anywhere in this repository.
#
# Where a value comes from is written beside it. The witness tools under
# tools/ derive the ones that are hashes of something else, so that they are
# computed by the same library the circuit checks them against.

# the Security Object read from the chip, zero padded
econtent = ["<your econtent>", "<your econtent>", "..."]  # 512 elements in total

# the true length of the Security Object, in bytes
econtent_len = "<your econtent len>"

# the CMS signed attributes, zero padded
signed_attrs = ["<your signed attrs>", "<your signed attrs>", "..."]  # 256 elements in total

# the true length of the signed attributes
signed_attrs_len = "<your signed attrs len>"

# byte offset of the messageDigest value inside signed_attrs
digest_offset = "<your digest offset>"

# the RSA modulus as 120 bit limbs
modulus_limbs = ["<your modulus limbs>", "<your modulus limbs>", "..."]  # 35 elements in total

# the Barrett parameter for that modulus
redc_limbs = ["<your redc limbs>", "<your redc limbs>", "..."]  # 35 elements in total

# the RSA signature as 120 bit limbs
signature_limbs = ["<your signature limbs>", "<your signature limbs>", "..."]  # 35 elements in total

# a fresh random value, or zero for the public registry convention; the anchor proof must use the same one
dsc_salt = "<your dsc salt>"

# your application, a non zero value distinct from every other application
domain = "<your domain>"

# a fresh non zero value the verifier issued for this exchange
context = "<your context>"
