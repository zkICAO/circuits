# Generated by fixtures/generator with the templates subcommand. Do not edit.
#
# Copy this to Prover.toml and replace every placeholder with your own
# material. Nothing here is a working value: a witness holds one holder's
# document, so no real one is committed anywhere in this repository.
#
# Where a value comes from is written beside it. The witness tools under
# tools/ derive the ones that are hashes of something else, so that they are
# computed by the same library the circuit checks them against.

# the field's length in bytes before packing
length = "<your length>"

# the packed field, from the opening tool
data = ["<your data>", "<your data>", "<your data>", "<your data>"]

# from tools/mrz_opening
entropy = "<your entropy>"

# from tools/merkle_path, or tools/mrz_opening for a field opening
siblings = ["<your siblings>", "<your siblings>", "<your siblings>", "<your siblings>"]

# which leaf of the published tree is yours
set_index = "<your set index>"

# from tools/merkle_path, or tools/mrz_opening for a field opening
set_siblings = ["<your set siblings>", "<your set siblings>", "..."]  # 8 elements in total

# which field this statement is about; see the profile
field_id = "<your field id>"

# from return[0] of the attributes proof
commitment = "<your commitment>"

# from tools/merkle_path over tools/set_entry_leaf entries
set_root = "<your set root>"

# your application, a non zero value distinct from every other application
domain = "<your domain>"

# a fresh non zero value the verifier issued for this exchange
context = "<your context>"
